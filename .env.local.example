# Required server-side administrator sign-in email.
ADMIN_EMAIL=your-email@example.com
# scrypt password hash for the administrator. Generate locally:
# node -e "const c=require('crypto');const s=c.randomBytes(16);console.log(['scrypt',16384,8,1,s.toString('base64url'),c.scryptSync('replace-with-password',s,64).toString('base64url')].join('$'))"
ADMIN_PASSWORD_HASH=your-scrypt-password-hash
# 32+ character server-only session signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=your-session-secret
# Required 32+ character server-side secret for encrypted account credentials.
ENCRYPTION_KEY=generate-a-32-byte-random-secret-for-account-password-encryption
# Public Supabase project URL; safe to expose because RLS denies anonymous private data access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only Supabase service-role key. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional public Meta browser Pixel ID.
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id
# Optional server-only Meta Conversions API token.
META_CONVERSIONS_API_TOKEN=your-meta-capi-token
# Optional WhatsApp Business Cloud credentials for owner-only order notifications.
# Without all three values, orders are still saved and the server logs one warning.
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_OWNER_PHONE=213xxxxxxxxx
